---
import { Image } from 'astro:assets';
import profile from '../../assets/profile.jpg';
import { site } from '../../data/site';
---

<section id="home" class="relative px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto grid max-w-[1400px] items-start gap-10 md:grid-cols-12 md:gap-14">
    <!-- Portrait breaks past the column edge on desktop, flush on mobile. -->
    <div class="md:col-span-5 md:-mt-10 lg:col-span-4 lg:-ml-6">
      <Image
        src={profile}
        alt={`Portrait of ${site.name}`}
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 30vw, 70vw"
        loading="lazy"
        class="w-full max-w-xs rounded-glass border border-line object-cover md:max-w-none"
      />
    </div>

    <div class="md:col-span-7 md:pt-6 lg:col-span-7 lg:col-start-6">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Professional summary</h2>
      <p class="mt-6 max-w-[65ch] text-base leading-relaxed text-muted sm:text-lg">
        {site.summary}
      </p>
    </div>
  </div>
</section>
