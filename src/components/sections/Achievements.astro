---
import { achievements, rarityColors } from '../../data/gamification';
import { GameIcon } from '../GameIcon';
---

<section id="achievements" class="relative px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-[1400px]">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Achievements</h2>
        <p class="mt-4 max-w-[55ch] text-base leading-relaxed text-muted">
          Unlockable milestones from real delivery work. Hover a badge to read the quest log.
        </p>
      </div>
      <p class="font-mono text-[11px] text-muted">
        {achievements.filter((a) => a.unlocked).length} / {achievements.length} unlocked
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        achievements.map((achievement) => (
          <article
            class="group glass flex flex-col gap-4 p-5 transition-all duration-300 hover:border-accent/40 hover:bg-surface/60"
            style={`--rarity: ${rarityColors[achievement.rarity]}`}
          >
            <div class="flex items-start justify-between gap-3">
              <div
                class="grid h-11 w-11 place-items-center rounded-glass border border-current/20 text-accent"
                style={{ color: rarityColors[achievement.rarity] }}
              >
                <GameIcon name={achievement.icon} size={22} />
              </div>
              <span
                class="rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider"
                style={{
                  color: rarityColors[achievement.rarity],
                  backgroundColor: `${rarityColors[achievement.rarity]}1a`,
                }}
              >
                {achievement.rarity}
              </span>
            </div>

            <div>
              <h3 class="text-base font-medium">{achievement.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{achievement.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
