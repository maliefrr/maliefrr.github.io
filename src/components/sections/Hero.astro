---
import { site } from '../../data/site';
import { Nebula } from '../Nebula';
---

<section
  id="hero"
  class="relative isolate flex min-h-[100dvh] items-center overflow-hidden px-4 pb-16 pt-24 sm:px-6"
>
  <!--
    Atmosphere, not an object: WebGL paints across the whole hero on desktop,
    with the CSS nebula and starfield underneath as its poster frame and as the
    fallback on mobile and under reduced motion.
  -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="nebula absolute inset-0"></div>
    <div class="starfield absolute inset-0 opacity-60"></div>
    <Nebula client:visible />
  </div>

  <div class="rise mx-auto w-full max-w-[1400px]">
    <!--
      Plain markup, deliberately not a framework island. The hero copy is the
      most important content on the page and must never depend on hydration to
      exist. The tilt below is progressive enhancement over static HTML.
    -->
    <div class="tilt glass w-full max-w-2xl p-7 sm:p-10" data-tilt>
      <h1 class="text-4xl font-medium leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        {site.name}
      </h1>

      <p class="mt-5 max-w-[46ch] text-base leading-relaxed text-muted sm:text-lg">
        {site.tagline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex h-11 items-center whitespace-nowrap rounded-glass bg-accent px-5 text-sm font-medium text-accent-ink transition-transform duration-200 hover:opacity-90 active:translate-y-px"
        >
          See my work
        </a>
        <a
          href="#contact"
          class="inline-flex h-11 items-center whitespace-nowrap rounded-glass border border-line px-5 text-sm font-medium text-text transition-colors duration-200 hover:border-accent hover:text-accent active:translate-y-px"
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Pointer tilt. Writes two CSS custom properties; the transform itself lives
  // in CSS, so a scripting failure degrades to a flat panel, never a blank one.
  const MAX_TILT_DEGREES = 5;

  const panel = document.querySelector<HTMLElement>('[data-tilt]');
  const allowsMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (panel && allowsMotion) {
    const setTilt = (x: number, y: number) => {
      panel.style.setProperty('--tilt-y', `${x * MAX_TILT_DEGREES}deg`);
      panel.style.setProperty('--tilt-x', `${-y * MAX_TILT_DEGREES}deg`);
    };

    panel.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const bounds = panel.getBoundingClientRect();
      setTilt(
        (event.clientX - bounds.left) / bounds.width - 0.5,
        (event.clientY - bounds.top) / bounds.height - 0.5
      );
    });

    panel.addEventListener('pointerleave', () => setTilt(0, 0));
  }
</script>
