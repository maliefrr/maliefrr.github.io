---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  projects.map(async (project) => ({
    data: project.data,
    Content: (await render(project)).Content,
  }))
);
---

<section id="projects" class="relative px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-[1400px]">
    <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Projects</h2>

    <!-- Equal cells. `items-stretch` plus `mt-auto` on the link row keeps every
         card the same height regardless of description length. -->
    <div class="mt-12 grid items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        rendered.map((project) => (
          <article class="glass group flex h-full flex-col overflow-hidden">
            <Image
              src={project.data.cover}
              alt={project.data.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
            />

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-medium">{project.data.title}</h3>

              <div class="mt-3 flex flex-wrap gap-1.5">
                {project.data.stack.map((tech) => (
                  <span class="rounded-glass border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="mt-4 text-sm leading-relaxed text-muted">
                <project.Content />
              </div>

              <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6">
                {project.data.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-accent underline-offset-4 transition-opacity duration-200 hover:underline hover:opacity-80"
                  >
                    {link.text}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
