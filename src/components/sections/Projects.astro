---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  projects.map(async (project) => ({
    data: project.data,
    Content: (await render(project)).Content,
  }))
);

const [feature, ...rest] = rendered;

/** Bento shape: one tall feature cell plus one cell per remaining project. */
const FEATURE_CELL = 'md:col-span-3 md:row-span-2';
const SIDE_CELL = 'md:col-span-2';
---

<section id="projects" class="relative px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-[1400px]">
    <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Projects</h2>

    <div class="mt-12 grid gap-4 md:grid-cols-5 md:auto-rows-fr">
      {
        [feature, ...rest].map((project, index) => (
          <article
            class:list={[
              'glass group flex flex-col overflow-hidden',
              index === 0 ? FEATURE_CELL : SIDE_CELL,
            ]}
          >
            <Image
              src={project.data.cover}
              alt={project.data.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              class:list={[
                'w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]',
                index === 0 ? 'aspect-[16/10]' : 'aspect-[16/9]',
              ]}
            />

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-medium">{project.data.title}</h3>

              <div class="mt-3 flex flex-wrap gap-1.5">
                {project.data.stack.map((tech) => (
                  <span class="rounded-glass border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="prose-none mt-4 text-sm leading-relaxed text-muted">
                <project.Content />
              </div>

              <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 pt-2">
                {project.data.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-accent underline-offset-4 transition-opacity duration-200 hover:underline hover:opacity-80"
                  >
                    {link.text}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
