---
import { skills } from '../../data/skills';
---

<section id="skills" class="relative bg-bg-deep px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-[1400px]">
    <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Skills</h2>

    <!-- Dense inline marks, no card containers: the row itself is the group. -->
    <ul class="mt-12 flex flex-wrap gap-x-10 gap-y-8 sm:gap-x-14">
      {
        skills.map((skill) => (
          <li class="group flex w-20 flex-col items-center gap-3 sm:w-24">
            <svg
              role="img"
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-9 w-9 fill-muted transition-colors duration-300 group-hover:fill-accent sm:h-10 sm:w-10"
            >
              <path d={skill.path} />
            </svg>
            <span class="text-center font-mono text-[11px] leading-tight text-muted transition-colors duration-300 group-hover:text-text">
              {skill.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
